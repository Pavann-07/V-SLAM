<?xml version="1.0"?>

<robot name="qbotix_rover">

  <!--
    QBotix 4-wheel Rover

    Coordinate convention:
      +X = FRONT
      +Y = LEFT
      +Z = UP

    Dimensions:
      Wheelbase: 0.50 m
      Wheel diameter: 0.30 m
      Wheel radius: 0.15 m
      Wheel track: 0.60 m
      Main chassis: 0.60 x 0.60 x 0.25 m

    Navigation TF:
      map
        |
       odom
        |
     base_link
       /    \
      /      \
 livox_frame  zed_camera_link
  -->


  <!-- ====================================================== -->
  <!-- MATERIALS                                               -->
  <!-- ====================================================== -->

  <material name="body_mat">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>

  <material name="wheel_mat">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="sensor_mat">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>

  <material name="arm_mat">
    <color rgba="0.55 0.55 0.58 1.0"/>
  </material>


  <!-- ====================================================== -->
  <!-- BASE                                                     -->
  <!-- ====================================================== -->

  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0.15"/>

      <mass value="50.0"/>

      <inertia
        ixx="5.0"
        ixy="0.0"
        ixz="0.0"
        iyy="5.0"
        iyz="0.0"
        izz="5.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.15"/>

      <geometry>
        <box size="0.60 0.60 0.25"/>
      </geometry>

      <material name="body_mat"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>

      <geometry>
        <box size="0.60 0.60 0.25"/>
      </geometry>
    </collision>

  </link>


  <!-- ====================================================== -->
  <!-- FOUR-WHEEL CHASSIS                                     -->
  <!-- ====================================================== -->

  <!-- Front-left wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.25 0.30 0.15" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Front-right wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.25 -0.30 0.15" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Rear-left wheel -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.25 0.30 0.15" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Rear-right wheel -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.25 -0.30 0.15" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
      <material name="wheel_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- ====================================================== -->
  <!-- ZED 2i CAMERA                                           -->
  <!-- ====================================================== -->

  <joint name="zed_camera_mount_joint" type="fixed">

    <parent link="base_link"/>
    <child link="zed_camera_link"/>

    <!--
      Current camera mounting position:
        X = 0.20 m
        Y = 0.00 m
        Z = 0.82 m

      Replace these values later with the actual
      measured ZED 2i mounting position.
    -->

    <origin
      xyz="0.20 0 0.82"
      rpy="0 0 0"/>

  </joint>


  <link name="zed_camera_link">

    <inertial>

      <mass value="0.3"/>

      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0005"
        iyz="0"
        izz="0.0005"/>

    </inertial>

    <visual>

      <geometry>
        <box size="0.12 0.07 0.05"/>
      </geometry>

      <material name="sensor_mat"/>

    </visual>

    <collision>

      <geometry>
        <box size="0.12 0.07 0.05"/>
      </geometry>

    </collision>

  </link>


  <!-- ====================================================== -->
  <!-- NAVIGATION FOOTPRINT                                    -->
  <!-- ====================================================== -->

  <joint name="base_footprint_joint" type="fixed">

    <parent link="base_link"/>
    <child link="base_footprint"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>


  <link name="base_footprint"/>


</robot>